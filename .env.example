# Copy to .env (repo root) and fill in. Every variable is optional unless noted.

# Required when EMBEDDING_PROVIDER or LLM_PROVIDER is "openai".
OPENAI_API_KEY=

EMBEDDING_PROVIDER=openai        # openai | fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536               # must match EMBEDDING_MODEL

LLM_PROVIDER=openai              # openai | fake
# Required when LLM_PROVIDER=openai. No default: pick a current small chat model from your
# OpenAI dashboard (gpt-4o-mini and gpt-5-mini are deprecated).
# LLM_MODEL=gpt-6-luna   (verify in dashboard)

RERANKER=none                    # none | cohere
# COHERE_API_KEY=                # required when RERANKER=cohere

DB_PATH=./data/inbox.db          # relative to backend/
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
LOG_JSON=false

WORKER_CONCURRENCY=2
CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_CANDIDATES=20
RRF_K=60
MAX_CHUNKS_PER_ITEM=3
RELEVANCE_MIN_FULL=0.45          # provisional, calibrated in M6
RELEVANCE_MIN_PARTIAL=0.30

FETCH_TIMEOUT_S=10
FETCH_MAX_BYTES=5000000
FETCH_MAX_REDIRECTS=3
NOTE_MAX_CHARS=50000
QUESTION_MAX_CHARS=1000
