# Copy to .env (repo root). Only GROQ_API_KEY is required; everything else has a working default.
# On Railway, set the same names as service variables (inline comments are for this file only).

# ===== Required ==============================================================================
# Groq API key, free tier: https://console.groq.com/keys (answers use openai/gpt-oss-120b).
GROQ_API_KEY=

# ===== Optional: answer verification ==========================================================
# Each answer sentence is checked against the sources it cites.
VERIFIER=off                     # off | jev (needs OPENROUTER_API_KEY) | groq (reuses the Groq key)
# OpenRouter key, optional: enables the TypeSafe Jev verifier (VERIFIER=jev). https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# ===== Deployment ============================================================================
DATA_DIR=./data                  # holds inbox.db; the container uses /data (mount a volume there)
DEMO_MODE=off                    # on: per-IP limits, item cap, JS rendering off (public demo)
DEMO_INGESTS_PER_HOUR=10
DEMO_QUERIES_PER_HOUR=30
DEMO_MAX_ITEMS=100
SEED_ON_EMPTY=off                # on: load the demo items when the inbox is empty (compose: on)
# FRONTEND_DIST=                 # set by the container: serve the built frontend from the API
# INBOX_PORT=8000                # docker compose only: host port to publish

# ===== Tuning (defaults are fine) ============================================================
# --- Embeddings: local and free by default (fastembed, CPU/ONNX). `make install` downloads the model.
EMBEDDING_PROVIDER=fastembed     # fastembed | openai | fake
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384                # must match EMBEDDING_MODEL (text-embedding-3-small: 1536)
# EMBEDDING_THREADS=1            # cap ONNX threads on small hosts (e.g. 1 vCPU)

# --- Chat: any OpenAI-compatible API (Groq free tier by default).
LLM_PROVIDER=openai_compatible   # openai_compatible | openai | fake
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=                   # same as GROQ_API_KEY; use it for another OpenAI-compatible API
# LLM_REASONING_EFFORT=low       # optional (low | medium | high); reasoning models only
# LLM_TEMPERATURE=0.2            # optional; omitted from requests when unset

# --- OpenAI (only when a provider above is "openai").
# OPENAI_API_KEY=
OPENAI_MAX_RETRIES=2             # SDK-level retries with backoff (honours Retry-After)
EMBEDDING_TIMEOUT_S=30
LLM_TIMEOUT_S=60

RERANKER=none                    # none | cohere  (cohere needs: uv sync --extra cohere)
# COHERE_API_KEY=                # required when RERANKER=cohere
RERANK_MODEL=rerank-v3.5
RERANK_TIMEOUT_S=10

# Verification tuning (VERIFIER and OPENROUTER_API_KEY are at the top).
JEV_MODEL=typesafe/jev-1.14
VERIFY_ESCALATE_BELOW=0.55       # Jev verdicts below this top probability are re-checked by Groq (dev-chosen, backend/eval/README.md)
VERIFY_TIMEOUT_S=30

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
LOG_JSON=false

WORKER_CONCURRENCY=2
INGEST_MAX_ATTEMPTS=3          # transient failures (timeouts, 5xx, provider) retry up to this
INGEST_RETRY_BASE_S=2          # backoff 2s, 4s, ... between attempts
CHUNK_TOKENS=350               # bge max_length is 512 tokens
CHUNK_OVERLAP_TOKENS=60
CHUNK_MAX_BLOCK_TOKENS=400     # tables/code kept whole up to this; must fit bge 512 with header
RETRIEVAL_CANDIDATES=20
RRF_K=60
MAX_CHUNKS_PER_ITEM=3
RELEVANCE_MIN_FULL=0.70          # bge cosine; below this the prompt gets the partial-answer hint
RELEVANCE_MIN_PARTIAL=0.59       # chosen on the dev split, reported on test (backend/eval/README.md)

FETCH_TIMEOUT_S=10
FETCH_MAX_BYTES=5000000
FETCH_MAX_REDIRECTS=3

# Headless-browser fallback for pages whose text only appears via JavaScript (off by default).
# Needs `make install-render`. Renders only when plain extraction finds < RENDER_MIN_CHARS.
JS_RENDER=off
RENDER_MIN_CHARS=500
RENDER_TIMEOUT_S=15
RENDER_MAX_PAGES=2
NOTE_MAX_CHARS=50000
QUESTION_MAX_CHARS=1000
