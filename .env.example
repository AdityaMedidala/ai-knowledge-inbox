# Copy to .env (repo root) and fill in. Every variable is optional unless noted.

# --- Embeddings: local and free by default (fastembed, CPU/ONNX). `make install` downloads the model.
EMBEDDING_PROVIDER=fastembed     # fastembed | openai | fake
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384                # must match EMBEDDING_MODEL (text-embedding-3-small: 1536)
# EMBEDDING_THREADS=1            # cap ONNX threads on small hosts (e.g. 1 vCPU)

# --- Chat: any OpenAI-compatible API (Groq free tier by default).
LLM_PROVIDER=openai_compatible   # openai_compatible | openai | fake
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Example only; verify the exact model ID in your provider's console before uncommenting.
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low       # optional (low | medium | high); reasoning models only
# LLM_TEMPERATURE=0.2            # optional; omitted from requests when unset

# --- OpenAI (only when a provider above is "openai").
# OPENAI_API_KEY=
OPENAI_MAX_RETRIES=2             # SDK-level retries with backoff (honours Retry-After)
EMBEDDING_TIMEOUT_S=30
LLM_TIMEOUT_S=60

RERANKER=none                    # none | cohere  (cohere needs: uv sync --extra cohere)
# COHERE_API_KEY=                # required when RERANKER=cohere
RERANK_MODEL=rerank-v3.5
RERANK_TIMEOUT_S=10

DB_PATH=./data/inbox.db          # relative to backend/
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
LOG_JSON=false

WORKER_CONCURRENCY=2
CHUNK_TOKENS=350               # bge max_length is 512 tokens
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_CANDIDATES=20
RRF_K=60
MAX_CHUNKS_PER_ITEM=3
RELEVANCE_MIN_FULL=0.70          # provisional (bge cosine), calibrated in M6
RELEVANCE_MIN_PARTIAL=0.60

FETCH_TIMEOUT_S=10
FETCH_MAX_BYTES=5000000
FETCH_MAX_REDIRECTS=3
NOTE_MAX_CHARS=50000
QUESTION_MAX_CHARS=1000
